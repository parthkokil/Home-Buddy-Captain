<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/work_request_shimmer_cardview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:elevation="10dp"
            android:padding="10dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="10dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp">

                <RelativeLayout
                    android:id="@+id/shimmer_name_lay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="2dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentStart="true">

                    <TextView
                        android:id="@+id/shimmer_name_text"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:background="@color/light_grey"
                        android:textColor="@color/black"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/shimmer_name_value"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:background="@color/light_grey"
                        android:layout_marginStart="10dp"
                        android:layout_toRightOf="@id/shimmer_name_text"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/shimmer_mob_lay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@id/shimmer_name_lay"
                    android:layout_alignParentTop="true"
                    android:padding="2dp"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:id="@+id/shimmer_mob_text"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:background="@color/light_grey"
                        android:textColor="@color/black"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/shimmer_mob_value"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:background="@color/light_grey"
                        android:layout_marginStart="3dp"
                        android:layout_toRightOf="@id/shimmer_mob_text"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/shimmer_service_lay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:padding="2dp"
                    android:layout_alignParentStart="true"
                    android:layout_below="@+id/shimmer_name_lay">

                    <TextView
                        android:id="@+id/shimmer_service_text"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:background="@color/light_grey"
                        android:textColor="@color/black"
                        android:textSize="18sp"/>

                    <TextView
                        android:id="@+id/shimmer_service_value"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:background="@color/light_grey"
                        android:layout_marginStart="10dp"
                        android:layout_toRightOf="@id/shimmer_service_text"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/shimmer_status_lay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:padding="2dp"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@+id/shimmer_service_lay"
                    android:layout_below="@+id/shimmer_name_lay">

                    <TextView
                        android:id="@+id/shimmer_status_text"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:background="@color/light_grey"
                        android:textColor="@color/black"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/shimmer_status_value"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:background="@color/light_grey"
                        android:layout_marginStart="3dp"
                        android:layout_toRightOf="@id/shimmer_status_text"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/shimmer_service_lay"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:paddingHorizontal="30dp"
                    android:layout_margin="10dp">

                    <Button
                        android:id="@+id/shimmer_declineBtn"
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/light_grey"
                        android:text=""
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:paddingHorizontal="30dp"
                        />

                    <Button
                        android:id="@+id/shimmer_acceptBtn"
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:backgroundTint="@color/light_grey"
                        android:paddingHorizontal="30dp"
                        android:text="" />
                </RelativeLayout>

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

    </ScrollView>

</LinearLayout>